{
  "name": "memel-photo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k -n web,worker -c blue,magenta \"npm run dev\" \"npm run worker\"",
    "build": "next build",
    "start": "next start",
    "worker": "tsx watch src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run check:migration && npm run check:membership && npm run check:queries && npm run check:publish-guard",
    "check:migration": "tsx src/scripts/check-migration.ts",
    "check:membership": "tsx src/scripts/check-membership.ts",
    "check:queries": "tsx src/scripts/check-queries.ts",
    "check:publish-guard": "tsx src/scripts/check-publish-guard.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:rebuild-membership": "tsx src/scripts/rebuild-membership.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "next": "^16.3.1",
    "pg": "^8.13.1",
    "pg-boss": "^12.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "thumbhash": "^0.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
