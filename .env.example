# Copy to .env and fill in. Generate secrets with the commands noted per line.

# --- Site --------------------------------------------------------------------
SITE_TITLE=Photography
APP_URL=https://photos.example.com

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=photos
POSTGRES_PASSWORD=                       # openssl rand -hex 24
POSTGRES_DB=photos
# Host part is the compose service name; change only if you run Postgres elsewhere.
DATABASE_URL=postgres://photos:CHANGEME@postgres:5432/photos

# --- Auth --------------------------------------------------------------------
BETTER_AUTH_SECRET=                      # openssl rand -base64 32
BETTER_AUTH_URL=https://photos.example.com

# Used once by `npm run db:seed` to create the first admin account.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=                          # change after first login
ADMIN_NAME=Admin

# --- Garage / S3 -------------------------------------------------------------
GARAGE_RPC_SECRET=                       # openssl rand -hex 32
GARAGE_ADMIN_TOKEN=                      # openssl rand -base64 32
GARAGE_METRICS_TOKEN=                    # openssl rand -base64 32

S3_ACCESS_KEY_ID=                        # "GK$(openssl rand -hex 16)"
S3_SECRET_ACCESS_KEY=                    # openssl rand -hex 32
S3_REGION=garage
S3_BUCKET_ORIGINALS=photos-originals
S3_BUCKET_DERIVED=photos-derived

# Server-to-server endpoint, inside the compose network. Never leaves the host.
S3_ENDPOINT_INTERNAL=http://garage:3900
# Endpoint browsers fetch presigned URLs from. MUST be publicly reachable and
# MUST be what the app signs with, or every signature will be rejected.
# Point this hostname at the garage container through your reverse proxy.
S3_ENDPOINT_PUBLIC=https://s3.photos.example.com

# How long a presigned URL stays valid. 6 hours.
PRESIGN_TTL_SECONDS=21600

# --- App behaviour -----------------------------------------------------------
# Minimum admin rating for Best of, in half-star units. 16 = 8.0 stars.
BEST_OF_MIN_RATING_HALF=16
# Visibility given to dated albums created automatically on upload.
# One of: public | unlisted | restricted. Keep restricted unless you want every
# import to be world-readable the moment it lands.
DEFAULT_DATED_ALBUM_VISIBILITY=restricted
# Keep GPS coordinates in the database. Derivatives are stripped either way.
STORE_GPS=false
# How many photos the worker encodes at once (sharp is CPU-heavy). Default 3.
PHOTO_WORKER_CONCURRENCY=3

# --- Storage paths on the Docker host ----------------------------------------
# Point these at the ZFS datasets (see README). Defaults are for local dev.
GARAGE_META_DIR=./data/garage-meta
GARAGE_DATA_DIR=./data/garage-data
POSTGRES_DATA_DIR=./data/postgres
